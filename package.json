{
  "name": "adm-canchas-tenis",
  "version": "0.0.1",
  "private": true,
  "description": "Tennis court administration monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "db:seed": "npm run db:seed --workspace=api",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "lucide-react": "^1.59.0"
  }
}
