# Clerk (ADR-0008) - claves en https://dashboard.clerk.com/~/api-keys
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Opcional (recomendado): PEM para verificacion networkless del session token
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# Opcional: firma del webhook (Clerk > Webhooks); requerido por /api/webhooks/clerk
# CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx
# Opcionales: origen del front y origenes autorizados del token (default http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Seed de demo (npm run db:seed): admin inicial en Clerk dev.
# El email y el password tienen defaults de dev; el password debe cumplir la
# policy de Clerk (mayuscula, numero y caracter especial).
# El email usa el patron +clerk_test: en dev, cualquier codigo OTP que pida Clerk es 424242 (no se envia mail).
# SEED_ADMIN_EMAIL=admin+clerk_test@admcanchastenis.dev
# SEED_ADMIN_PASSWORD=AdmCanchas#2026
